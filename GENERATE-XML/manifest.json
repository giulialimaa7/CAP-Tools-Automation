{
  "manifest_version": 3,
  "name": "GENERATE-XML",
  "version": "1.0",
  "description": "Extensão para coletar dados e gerar XML",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Gerar arquivo XML"
  },
  "content_scripts": [
    {
      "matches": ["https://www.eneldistribuicao.com.br/PortalGD/ENELRJ/*"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ]
}
